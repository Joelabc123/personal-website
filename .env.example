# Copy this file to .env(.local) and fill in the values.

# Public canonical origin used by metadata, structured data, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://joelbakirel.de

# --- SMTP (Nodemailer) ---
# Used by app/api/contact/route.ts to send the contact form email. 
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inbox that receives the admin notification for every contact form submission.
CONTACT_ADMIN_EMAIL=

# ---- Google reCAPTCHA v3 ----
# https://www.google.com/recaptcha/admin
# Public site key. Coolify Compose maps it to a runtime-only container variable;
# local Next.js development can read this backward-compatible public name.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key, server-side only, used to verify tokens in the API route.
RECAPTCHA_SECRET_KEY=
