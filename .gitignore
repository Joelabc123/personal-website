# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Unsorted private gallery uploads: keep instructions, never original images.
/content/gallery-upload/**/*
!/content/gallery-upload/README.md

# Unsorted project image uploads: keep instructions, never original images.
/content/projects-upload/**/*
!/content/projects-upload/README.md

# Gallery output is rebuilt from private sources before dev/build.
/public/generated/gallery/
/lib/generated/gallery-manifest.json
